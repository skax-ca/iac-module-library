# Terraform 로컬 상태 및 캐시
# 주의: .terraform.lock.hcl 은 커밋 대상 (provider 버전 고정). 무시하지 않는다.
.terraform/
*.tfstate
*.tfstate.*
crash.log
crash.*.log

# 변수 파일 (민감정보 포함 가능) - example만 커밋
*.tfvars
*.tfvars.json
!*.tfvars.example

# 재정의 파일
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI 설정 및 자격증명
.terraformrc
terraform.rc
*.pem
*.key

# OS / 에디터
.DS_Store
.idea/
.vscode/

# Python 캐시 (scripts/*.py 로컬 실행 시 생성)
__pycache__/

# 로컬 전용 작업물 (push 안 함) — 팀 공유 자료 초안·개인 스크래치 등
.local/

# opencode 플러그인 런타임 의존성 — node_modules/package-lock.json 은 .opencode/.gitignore 가 무시
# .opencode/agents|commands|plugins/*.ts, package.json, bun.lock 은 커밋 대상

# OMC 런타임 상태 (커밋 제외)
#
# 규칙 순서에 의미가 있다. 함부로 재배열하지 말 것.
#  1) 모든 depth의 .omc/ 를 제외 (하위 모듈·live 루트의 .omc/ 포함)
#  2) 루트 .omc/ '디렉토리'만 되살린다 — git은 디렉토리가 제외되면 내부로
#     내려가지 않아 하위 `!` 재포함이 무효가 되기 때문(3~5행이 동작하려면 필수)
#  3) 루트 .omc/ 의 '내용물'을 제외
#  4~5) 그중 커밋할 것만 재포함
**/.omc/
!/.omc/
/.omc/*
# 크로스머신(집↔회사 Mac) 핸드오프용 SSOT 2개
# — notepad.md(세션 로그·Priority는 500자 이내 포인터만) + project-memory.json(구조화 사실)
!/.omc/notepad.md
!/.omc/project-memory.json
# 프로젝트 스코프 스킬 (OMC 규약상 커밋 대상)
!/.omc/skills/
