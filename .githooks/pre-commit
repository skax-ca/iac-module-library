#!/usr/bin/env bash
# pre-commit — OpenTofu 로컬 게이트 (fmt → tflint → trivy)
# 활성화: git config core.hooksPath .githooks  (clone마다 1회, CLAUDE.md 검증 절 참조)
# 의도적 우회는 git commit --no-verify (사유를 커밋 메시지에 남길 것)
set -euo pipefail

# 약어 카탈로그(데이터 SSOT)가 staged되면 SSOT 검사 — 문서 중 유일하게 코드 게이트가 있는 것.
# CI(.github/workflows/verify.yml docs-ssot)와 같은 명령을 실행한다.
changed=$(git diff --cached --name-only --diff-filter=ACMR)
if printf '%s\n' "$changed" | grep -qx 'docs/aws-naming-abbreviations.md'; then
  echo "[pre-commit] 약어 카탈로그 변경 — SSOT 검사"
  python3 scripts/validate-abbreviations.py
fi

# Terraform 관련 파일이 staged된 경우에만 실행 (문서 커밋엔 비용 0)
staged=$(printf '%s\n' "$changed" | grep -E '\.(tf|tfvars)$|\.terraform\.lock\.hcl$|^\.tflint\.hcl$|^\.trivyignore(\.yaml)?$' || true)
[ -z "$staged" ] && exit 0

echo "[pre-commit] Terraform 변경 감지 — 로컬 게이트 실행"

echo "  1/3 tofu fmt -check"
tofu fmt -recursive -check

echo "  2/3 tflint --recursive"
tflint --recursive

echo "  3/3 trivy config (MEDIUM+)"
# .terraform/(init 캐시)과 다운로드된 원격 모듈 내부는 우리가 수정할 수 없는 upstream 코드 —
# 게이트 대상에서 제외한다. upstream 경유 보안 손잡이(예: EKS 컨트롤플레인 로깅)는
# 설계 문서 열린 항목으로 추적한다.
# ⚠️ --ignorefile 은 생략할 수 없다: trivy 0.72는 .trivyignore.yaml 을 **자동 탐지하지 않는다**
#    (평면 .trivyignore 만 자동이다). 경로 한정 예외를 쓰려면 YAML 형식이 필요하므로 명시한다.
trivy config --quiet --exit-code 1 --severity MEDIUM,HIGH,CRITICAL \
  --skip-dirs '**/.terraform' --tf-exclude-downloaded-modules \
  --ignorefile .trivyignore.yaml .

echo "[pre-commit] 게이트 통과 ✓"
