#!/usr/bin/env bash
# pre-commit — OpenTofu 로컬 게이트 (fmt → tflint → trivy) + 문서 게이트
# 활성화: git config core.hooksPath .githooks  (clone마다 1회, CLAUDE.md 검증 절 참조)
# 의도적 우회는 git commit --no-verify (사유를 커밋 메시지에 남길 것)
set -euo pipefail

# 약어 카탈로그(데이터 SSOT)가 staged되면 SSOT 검사 — 문서 중 유일하게 코드 게이트가 있는 것.
# CI(.github/workflows/verify.yml docs-ssot)와 같은 명령을 실행한다.
changed=$(git diff --cached --name-only --diff-filter=ACMR)
catalogs=$(printf '%s\n' "$changed" | grep -E '^docs/naming/abbreviations/.*\.md$' || true)
if [ -n "$catalogs" ]; then
  echo "[pre-commit] 약어 카탈로그 변경 — SSOT 검사"
  # shellcheck disable=SC2086
  python3 scripts/validate-abbreviations.py $catalogs
fi

# 문서 작성 규칙(docs/writing-style.md) — 절 번호 인용·비표준 이모지·400줄 초과를 기계로 잡는다.
# 적용 범위는 writing-style.md가 스스로 선언한 것과 같다: docs/*.md · 저장소 전역 README.md ·
# 루트 CLAUDE.md. staged된 파일만 검사한다(스크립트가 인자를 받으면 그것만 본다).
docs_staged=$(printf '%s\n' "$changed" | grep -E '^docs/.*\.md$|(^|/)README\.md$|^CLAUDE\.md$' || true)
if [ -n "$docs_staged" ]; then
  echo "[pre-commit] 문서 변경 감지 — 작성 규칙 검사"
  # shellcheck disable=SC2086
  python3 scripts/validate-doc-conventions.py $docs_staged
fi

# 하드코딩된 ref=<component>-vX.Y.Z 소스 태그가 실제 최신 태그와 어긋나는지 검사.
# README의 Usage 예시는 terraform-docs가 관리하지 않는 손으로 쓴 코드라 태그를 올려도 같이
# 움직이지 않는다. 소비자가 그 예시를 복사하면 낡은 모듈을 소싱하게 된다.
# 검사 대상은 `ref=` 바로 뒤에 붙은 태그뿐이다(그 밖의 산문 속 과거 버전 언급,
# 예: "vpc-v0.2.0이 고친 버그"는 의도적 역사 서술이라 오탐이 아니라 그냥 대상이 아니다).
md_staged=$(printf '%s\n' "$changed" | grep -E '\.md$' || true)
if [ -n "$md_staged" ]; then
  stale_found=0
  while IFS= read -r f; do
    [ -f "$f" ] || continue
    while IFS=: read -r lineno match; do
      [ -z "$match" ] && continue
      component=$(printf '%s' "$match" | sed -E 's/^ref=(.+)-v[0-9]+\.[0-9]+\.[0-9]+$/\1/')
      latest=$(git tag -l "${component}-v*" | sort -V | tail -1)
      tag=${match#ref=}
      if [ -n "$latest" ] && [ "$tag" != "$latest" ]; then
        echo "[pre-commit] ⚠️  $f:$lineno — ref=$tag 가 최신 태그($latest)와 다르다."
        echo "    의도적 역사 서술이 아니면 태그를 갱신하거나 vX.Y.Z 자리표시자로 바꾼다."
        stale_found=1
      fi
    done < <(grep -noE 'ref=(vpc|eks-cluster|workbench|cross-account-trust-role|vnet|aks-cluster)-v[0-9]+\.[0-9]+\.[0-9]+' "$f")
  done <<< "$md_staged"
  if [ "$stale_found" -eq 1 ]; then
    echo "[pre-commit] stale 태그 참조 발견 — 의도적이면 git commit --no-verify로 우회(사유를 커밋 메시지에 명시)"
    exit 1
  fi
fi

# 주석 좌표 금지(docs/conventions.md 코드 규약 절) — 절 번호 인용 기호·결정 식별자·날짜를
# 기계로 잡는다. CI(.github/workflows/verify.yml comment-conventions)와 같은 스크립트를 실행한다.
# 한쪽을 바꾸면 다른 쪽도 바꾼다. 여기는 staged된 것만, CI는 전체를 본다(속도 차이).
# 훅 파일도 대상이다. 규약은 산문이 실리는 면을 확장자로 가르지 않는데, 훅 주석은 그 면이면서
# 검사에서 빠져 있었다. 대상 목록의 SSOT는 스크립트의 default_targets()다.
coord_staged=$(printf '%s\n' "$changed" | grep -v '/\.terraform/' |
  grep -E '^modules/.*\.(tf|tftest\.hcl)$|^\.githooks/pre-(commit|push)$' || true)
if [ -n "$coord_staged" ]; then
  echo "[pre-commit] 코드 변경 감지 — 주석 좌표 검사"
  # shellcheck disable=SC2086
  python3 scripts/validate-comment-conventions.py $coord_staged
fi

# 셸 게이트. bash -n 은 문법만 보고, shellcheck 는 인용·확장·종료코드 실수를 본다.
# -x 로 source 된 파일을 따라간다. 훅은 항상 저장소 루트에서 도므로 상대 경로가 그대로 맞는다.
# 이 저장소는 셸을 소유하지 않는다(거버넌스 도구는 전부 python, scripts/README.md). 지금 걸리는
# 것은 훅 파일 자신뿐이다. git 훅은 이름이 규격이라 확장자를 못 붙이므로 이름으로 적고,
# .githooks/ 통째가 아니라 두 이름으로 좁혀 비셸 파일이 섞여도 안전하게 한다. bootstrap·scripts·
# 스킬 경로를 함께 둔 것은 형제 저장소와 이 줄을 같게 유지해 diff로 대조하기 위해서다. 없는
# 경로는 매치가 없어 비용이 0이고, 셸이 새로 생기면 범위를 다시 넓히지 않아도 덮인다.
# bash -n·shellcheck 는 파싱·정적 분석이라 훅을 다시 실행하지 않는다(재귀가 아니다).
# 훅이 깨지면 실행이 알려 줄 거라는 기대는 틀렸다: 아래 조기 exit 뒤쪽의 문법 오류는 실행이
# 도달하지 못해 드러나지 않고, 파일 전체를 보는 것은 bash -n 뿐이다. 남는 사각지대는 이
# 검사보다 앞선 줄이 망가져 게이트 자체를 건너뛰는 경우 하나다.
sh_staged=$(printf '%s\n' "$changed" | grep -v '/\.terraform/' |
  grep -E '^(bootstrap|scripts)/.*\.sh$|^\.claude/skills/.*\.sh$|^\.githooks/pre-(commit|push)$' || true)
if [ -n "$sh_staged" ]; then
  echo "[pre-commit] 셸 변경 감지 — 문법·정적 검사"
  command -v shellcheck >/dev/null || {
    echo "  ✗ shellcheck 가 없다: brew install shellcheck (clone마다 1회)" >&2
    exit 1
  }
  for f in $sh_staged; do
    bash -n "$f"
    shellcheck -x "$f"
  done
fi

# Terraform 관련 파일이 staged된 경우에만 실행 (문서 커밋엔 비용 0)
staged=$(printf '%s\n' "$changed" | grep -E '\.(tf|tfvars)$|\.terraform\.lock\.hcl$|^\.tflint\.hcl$|^\.trivyignore(\.yaml)?$' || true)
[ -z "$staged" ] && exit 0

echo "[pre-commit] Terraform 변경 감지 — 로컬 게이트 실행"

echo "  1/4 tofu fmt -check"
tofu fmt -recursive -check

# ruleset이 늘 때마다(azurerm 추가 등) 로컬 플러그인 캐시가 없으면 --recursive가 바로 죽는다.
# 이미 설치돼 있으면 빠르게 스킵되므로 매 커밋 비용은 무시할 만하다.
echo "  2/4 tflint --init"
GITHUB_TOKEN="${GITHUB_TOKEN:-$(gh auth token 2>/dev/null || true)}" tflint --init

echo "  3/4 tflint --recursive"
tflint --recursive

echo "  4/4 trivy config (MEDIUM+)"
# .terraform/·다운로드된 원격 모듈은 upstream 코드라 게이트 대상에서 제외한다(보안 손잡이는
# 설계 문서 열린 항목으로 추적). ⚠️ --ignorefile 생략 불가 — trivy 0.72는 .trivyignore.yaml 을
# 자동 탐지하지 않는다(평면 .trivyignore 만 자동), 경로 한정 예외엔 이 형식이 필요하다.
trivy config --quiet --exit-code 1 --severity MEDIUM,HIGH,CRITICAL \
  --skip-dirs '**/.terraform' --tf-exclude-downloaded-modules \
  --ignorefile .trivyignore.yaml .

# terraform-docs version: v0.24.0
# 모듈 .tf가 staged되면 README.md가 그 변경을 반영했는지 drift 검사.
modules_tf_staged=$(printf '%s\n' "$staged" | grep -E '^modules/[^/]+/[^/]+/[^/]+\.tf$' || true)
if [ -n "$modules_tf_staged" ]; then
  echo "  terraform-docs drift 검사"
  for m in $(printf '%s\n' "$modules_tf_staged" | sed -E 's#^(modules/[^/]+/[^/]+)/.*#\1#' | sort -u); do
    terraform-docs markdown table --output-mode inject --output-check --output-file README.md "$m/"
  done
fi

echo "[pre-commit] 게이트 통과 ✓"
