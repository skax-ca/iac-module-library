{
  "mcpServers": {
    "terraform": {
      "type": "stdio",
      "command": "${HOME}/go/bin/terraform-mcp-server",
      "args": [
        "stdio",
        "--toolsets=registry"
      ],
      "env": {}
    },
    "aws-docs": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "awslabs.aws-documentation-mcp-server@latest"
      ],
      "env": {
        "FASTMCP_LOG_LEVEL": "ERROR",
        "AWS_DOCUMENTATION_PARTITION": "aws",
        "SSL_CERT_FILE": "${HOME}/.claude/certs/ca-bundle.pem",
        "REQUESTS_CA_BUNDLE": "${HOME}/.claude/certs/ca-bundle.pem",
        "AWS_CA_BUNDLE": "${HOME}/.claude/certs/ca-bundle.pem"
      }
    }
  }
}
